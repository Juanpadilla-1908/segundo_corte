package parcial_2;
import java.util.Scanner;

public class ControlGastosFamiliares {
	

	    public static void main(String[] args) {
	        Scanner sc = new Scanner(System.in);
	        
	        
	        String[] categorias = {"Alimentación", "Servicios", "Ocio"};
	        int semana = 4;
	        
	        
	        double[][] gastos = new double[3][semana];
	        
	        
	        System.out.println("=== INGRESO DE GASTOS  ===");
	        for (int i = 0; i < categorias.length; i++) {
	            System.out.println("\nCategoría: " + categorias[i]);
	            for (int j = 0; j < semana ; j++) {
	                System.out.print("Ingrese gasto del la semana" + (j + 1) + ": ");
	                gastos[i][j] = sc.nextDouble();
	            }
	        }
	        
	      
	        System.out.println("\n=== MATRIZ ORIGINAL DE GASTOS ===");
	        mostrarMatriz(gastos, categorias);
	        
	     
	        double[][] matrizOrdenada = ordenarBurbuja(gastos);
	        
	        System.out.println("\n=== MATRIZ ORDENADA  ===");
	        mostrarMatriz(matrizOrdenada, categorias);
	        
	       
	        double[] totales = new double[categorias.length];
	        for (int i = 0; i < categorias.length; i++) {
	            double suma = 0;
	            for (int j = 0; j <semana; j++) {
	                suma += gastos[i][j];
	            }
	            totales[i] = suma;
	        }
	        
	     
	        System.out.print("\nArreglo de totales: [ ");
	        for (int i = 0; i < totales.length; i++) {
	            System.out.print((int)totales[i]);
	            if (i < totales.length - 1) System.out.print(", ");
	        }
	        System.out.println(" ]");
	        
	       
	        ordenarBurbuja1D(totales);
	        
	      
	        System.out.print("\nTotales ordenados de menor a mayor: [ ");
	        for (int i = 0; i < totales.length; i++) {
	            System.out.print((int)totales[i]);
	            if (i < totales.length - 1) System.out.print(", ");
	        }
	        System.out.println(" ]");
	        
	        sc.close();
	    }
	    
	  
	    public static void mostrarMatriz(double[][] matriz, String[] categorias) {
	        for (int i = 0; i < matriz.length; i++) {
	            System.out.print(categorias[i] + ": ");
	            for (int j = 0; j < matriz[i].length; j++) {
	                System.out.print((int)matriz[i][j] + "\t");
	            }
	            System.out.println();
	        }
	    }

	   
	    public static double[][] ordenarBurbuja(double[][] matriz) {
	        double[][] ordenada = new double[matriz.length][matriz[0].length];
	        
	        for (int i = 0; i < matriz.length; i++) {
	         
	            for (int j = 0; j < matriz[i].length; j++) {
	                ordenada[i][j] = matriz[i][j];
	            }
	          
	            for (int a = 0; a < matriz[i].length - 1; a++) {
	                for (int b = 0; b < matriz[i].length - 1 - a; b++) {
	                    if (ordenada[i][b] > ordenada[i][b + 1]) {
	                        double temp = ordenada[i][b];
	                        ordenada[i][b] = ordenada[i][b + 1];
	                        ordenada[i][b + 1] = temp;
	                    }
	                }
	            }
	        }
	        return ordenada;
	    }
	    
	  
	    public static void ordenarBurbuja1D(double[] arreglo) {
	        for (int i = 0; i < arreglo.length - 1; i++) {
	            for (int j = 0; j < arreglo.length - 1 - i; j++) {
	                if (arreglo[j] > arreglo[j + 1]) {
	                    double temp = arreglo[j];
	                    arreglo[j] = arreglo[j + 1];
	                    arreglo[j + 1] = temp;
	                }
	            }
	        }
	    }
	}


